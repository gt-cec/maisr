{
	"window_size": [1000,1100],
	"gameboard_size": 1000, # Sets game map size. "gameboard_size" * "gameboard_size" pixels.
	"tick_rate": 10,
	"time_limit": 245,
	"game_speed": 0.7,
	"agent_speed": 2.8,
	"num_aircraft": 2,
	"seed": 42,

	"max_steps": 1500, # Maximum number of inner steps (base_env._single_step) per episode. Divide by frame_skip to get total number of steps the agent sees.
	"frame_skip": 35,
	"action_rate": 20,

	# Game mechanic tuning
	"num_targets": 15, # Number of regular targets on the map
	"num_threats": 4, # Number of high-value targets
	"time_to_id": 1, # How many steps an agent needs to be in range to ID a target. Set to 1 for instant ID
	"prob_detect": 0, # Probability of being detected by high-value targets, which imposes an additional penalty.
	"threat_radius": 30, # If prob_detect > 0, this sets the radius at which high-value targets can detect you.
	"max_threat_ids": 2, # Number of high-value targets the team needs to identify. Identifying more than this results in a penalty.

    "league_type": "selfplay", # Which teammate league to use in training. Used by the LeagueManager
	"switch_leagues": false, # Whether to switch league settings partway through training.
	"balance_method": "uniform", #

	# Observation settings
	"obs_type": "nearest",
	"obs_noise_std_localsearch": 0.01,
	"observe_teammate": true,
	"observe_teammate_direction": true,
	"observe_teammate_priority": true,
	"num_observed_targets": 5, # Number of regular targets observed by the agent if using the 'nearest' observation type
	"num_observed_threats": 2, # Number of high-value targets observed by the agent if using the 'nearest' observation type

	# Action settings
	"action_type": "Discrete16", # Discrete16, Discrete8, target_index
	"action_noise_std": 0, # Standard deviation of noise to add to agent's actions.

	# Reward settings
	"base_env_target_id_reward": 2,
	"teammate_reward_scale": 0.75,
	"threat_id_reward": 11,
	"shaping_decay_rate": 1,

	"potential_ratio": 1.0, # Used to scale potential (shaping) rewards relative to core rewards.
	"target_potential_coeff": 0.05, # Coefficient for shaping rewards for approaching unknown regular targets
	"threat_potential_coeff": 0.18, # Coefficient for shaping rewards for approaching unknown high-value targets
	"shaping_coeff_earlyfinish": 0.2, # Coefficient for shaping rewards for finishing early. Reward = (max inner steps - inner steps) * coeff
	"threat_reward_scaling": 0.3, # Used to scale the rewards earned for identifying high-value targets relative to regular targets

	"use_dynamic_potential": true, # If true, the agent does not earn shaping rewards for approaching targets that the teammate agent is already aprpoaching
	"use_teammate_priority_shaping": false,

	"team_dist_shaping_coeff": 0, # If >0, the agent is penalized for being too close to the teammate
	"team_dist_penalty_threshold": 150, # Distance at which the agent starts receiving proximity penalties

	"team_spread_bonus_coeff": 0.0025, # Coefficient for shaping rewards awarded for the team spreading out on the map
	"team_min_optimal_distance": 200, # Sets the minimum distance at which the team starts receiving shaping rewards.
	"team_max_bonus_distance": 350, # Spread out shaping rewards stop increasing after this distance

	# Training hyperparameters
	"algo": "PPO", # Training algorithm. Default = PPO
	"policy_type": "MLPPolicy", # StableBaselines3 policy type. Default = MLPPolicy
	"network_size": 128, # Num neurons in each layer of the agent's policy. Default = 128
	"network_numlayers": 2, # Num layers in the agent's policy. Default = 2
	"activation_fn": "Tanh", # Default = Tanh
	"lr": 0.0005, # Default = 0.0005
	"batch_size": 1024, # Default = 1024
	"gamma": 0.985, # Default = 0.985

	"ppo_update_steps": 512, # Default = 512
	"entropy_regularization": 0.07, # Default = 0.07
	"use_entropy_decay_schedule": true, # If true, the training algorithm gradually reduces entropy decay once the agent reaches a specific performance threshold
	"entropy_decay_steps": 3e6,
	"entropy_decay_trigger_threshold": 0.34, # mean_target_ids_per_step threshold
	"entropy_decay_threat_threshold": 1.5, # eval/mean_threat_ids threshold
	"entropy_final_ratio": 0.5, # Final entropy = 50% of original,

	"vf_coef":0.5, # Default 0.5
	"n_epochs":10, # Default 10
	"clip_range": 0.2, # For PPO
	"run_human_eval": true, # If true, agents are evaluated against recorded human gameplay during the eval callback in addition to the regular eval

	"num_timesteps": 3e6, # Total training timesteps
	"save_freq": 125000,
	"n_eval_episodes": 7,
	"eval_freq": 1000,

	"teammate_active_at_start": true, # Whether the teammate (agent 1) is active initially. Used during training.
	"twoship_switch_threshold": 6, # During training, the teammate is set to active once the ego agent reaches this target ID performance threshold during evaluation.

	# Debug verbosity
	"verbose": false,
	"print_reward_debug": false,

	# Curriculum learning parameters
	"use_curriculum": false,
	"levels_per_lesson": {"0": 5, "1": 5, "2":  5},
	"gameboard_size_per_lesson": {"0": 1000, "1": 1000, "2": 1000},
	"agent_start_locations_per_lesson": {"0": 1, "1": 1, "2": 1}, # Number of unique agent start locations to use in each curriculum level. Use 99 to randomize the start location
	"use_fixed_levels": true,
	"num_fixed_levels": 7,
	"force_specific_level": 99,

	"min_target_ids_to_advance": 8,
	"starting_difficulty": 0,
	"max_difficulty": 2

}
